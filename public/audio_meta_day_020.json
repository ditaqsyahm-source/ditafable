  "sentences": [
    {
      "start": 0.05,
      "end": 8.259,
      "duration": 8.209,
      "text": "Di tepi hutan kenari yang tenang, Gajah, Rusa, sedang duduk memandangi jalan setapak berkabut."
    },
    {
      "start": 8.259,
      "end": 11.493,
      "duration": 3.235,
      "text": "Tiba-tiba, 'Kletuk!'"
    },
    {
      "start": 11.493,
      "end": 17.099,
      "duration": 5.606,
      "text": "Ada sesuatu yang membuat hatinya berdebar cemas saat Kancil datang mendekat."
    },
    {
      "start": 17.099,
      "end": 26.364,
      "duration": 9.265,
      "text": "Meski sempat merasa takut, Gajah, Rusa, memilih untuk bersikap jujur dan berbicara dengan penuh kelembutan."
    },
    {
      "start": 26.364,
      "end": 37.06,
      "duration": 10.696,
      "text": "Mendengar kata-katanya yang tulus, Kancil tersenyum teduh dan memeluknya hangat: 'Kebaikan hatimu jauh lebih berharga daripada apa pun.'"
    },
    {
      "start": 37.06,
      "end": 42.46,
      "duration": 5.399,
      "text": "Kecerdikan menemukan mata air menyelamatkan seluruh penghuni hutan."
    },
    {
      "start": 42.46,
      "end": 50.939,
      "duration": 8.479,
      "text": "Sekarang, tarik selimut hangatmu, pejamkan matamu ya... selamat tidur, dan mimpi indah."
    }
  ],
