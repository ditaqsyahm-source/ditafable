    {
      "start": 0.05,
      "end": 9.457,
      "duration": 9.407,
      "text": "Di hamparan padang rumput hijau berembun segar, Gajah, Rusa, melangkah riang menikmati hangatnya cahaya mentari."
    },
    {
      "start": 9.457,
      "end": 17.705,
      "duration": 8.247,
      "text": "Ketika tugas besar terasa berat bila dipikul sendiri, Kancil hadir menawarkan bantuan dengan riang gembira."
    },
    {
      "start": 17.705,
      "end": 24.122,
      "duration": 6.418,
      "text": "Bahu-membahu mereka menyatukan kekuatan hingga pekerjaan selesai dengan sempurna."
    },
    {
      "start": 24.122,
      "end": 31.944,
      "duration": 7.822,
      "text": "Di bawah langit malam bertabur bintang gemerlap, hati mereka dipenuhi rasa aman dan persaudaraan yang erat."
    },
    {
      "start": 31.944,
      "end": 37.331,
      "duration": 5.387,
      "text": "Kecerdikan menemukan mata air menyelamatkan seluruh penghuni hutan."
    },
    {
      "start": 37.331,
      "end": 45.746,
      "duration": 8.415,
      "text": "Sekarang, tarik selimut hangatmu, pejamkan matamu ya... selamat tidur, dan mimpi indah."
    }
  ],
