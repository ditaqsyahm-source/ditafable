    {
      "start": 0.05,
      "end": 7.266,
      "duration": 7.216,
      "text": "Di tepi hutan kenari yang tenang, Gani si Gajah sedang duduk memandangi jalan setapak berkabut."
    },
    {
      "start": 7.266,
      "end": 10.527,
      "duration": 3.26,
      "text": "Tiba-tiba, 'Kletuk!'"
    },
    {
      "start": 10.527,
      "end": 16.313,
      "duration": 5.786,
      "text": "Ada sesuatu yang membuat hatinya berdebar cemas saat Pipit Cilik datang mendekat."
    },
    {
      "start": 16.313,
      "end": 24.779,
      "duration": 8.466,
      "text": "Meski sempat merasa takut, Gani si Gajah memilih untuk bersikap jujur dan berbicara dengan penuh kelembutan."
    },
    {
      "start": 24.779,
      "end": 35.63,
      "duration": 10.851,
      "text": "Mendengar kata-katanya yang tulus, Pipit Cilik tersenyum teduh dan memeluknya hangat: 'Kebaikan hatimu jauh lebih berharga daripada apa pun.'"
    },
    {
      "start": 35.63,
      "end": 41.004,
      "duration": 5.374,
      "text": "Kekuatan sejati terlihat dari cara menjaga makhluk yang paling lemah."
    },
    {
      "start": 41.004,
      "end": 49.444,
      "duration": 8.441,
      "text": "Sekarang, tarik selimut hangatmu, pejamkan matamu ya... selamat tidur, dan mimpi indah."
    }
  ],
