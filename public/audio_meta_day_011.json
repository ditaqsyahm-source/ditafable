  "sentences": [
    {
      "start": 0.05,
      "end": 8.181,
      "duration": 8.131,
      "text": "Gani si gajah kecil memiliki langkah kaki yang begitu besar dan perkasa hingga tanah bergetar saat ia berjalan."
    },
    {
      "start": 8.181,
      "end": 18.465,
      "duration": 10.284,
      "text": "Suatu siang di hutan jati, Gani hampir menginjak sebatang dahan rendah tempat bersarangnya tiga ekor anak burung pipit yang belum bisa terbang."
    },
    {
      "start": 18.465,
      "end": 27.009,
      "duration": 8.544,
      "text": "Mendengar cicit ketakutan sang induk burung, Gani segera menghentikan langkah beratnya dan menahan kakinya di udara."
    },
    {
      "start": 27.009,
      "end": 35.746,
      "duration": 8.737,
      "text": "Dengan belalainya yang lembut, Gani perlahan memindahkan ranting sarang itu ke atas dahan pohon yang lebih tinggi dan kokoh."
    },
    {
      "start": 35.746,
      "end": 44.638,
      "duration": 8.892,
      "text": "Sang induk pipit berkicau penuh syukur: 'Tubuhmu memang raksasa, tapi hatimu sangat lembut dan menjaga.'"
    },
    {
      "start": 44.638,
      "end": 53.349,
      "duration": 8.711,
      "text": "Kekuatan sejati bukan tentang seberapa besar kita berkuasa, melainkan bagaimana kita melindungi yang paling kecil."
    },
    {
      "start": 53.349,
      "end": 61.88,
      "duration": 8.531,
      "text": "Sekarang, tarik selimut hangatmu, pejamkan matamu ya... selamat tidur, dan mimpi indah."
    }
  ],
