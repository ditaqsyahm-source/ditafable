  "sentences": [
    {
      "start": 0.05,
      "end": 7.564,
      "duration": 7.514,
      "text": "Pernahkah kamu melihat burung merak yang begitu bangga dengan bulunya, sampai lupa menyapa sahabatnya?"
    },
    {
      "start": 7.564,
      "end": 14.277,
      "duration": 6.713,
      "text": "Miko si merak emas selalu memamerkan ekornya yang berkilau di hadapan burung pipit kecil."
    },
    {
      "start": 14.277,
      "end": 20.952,
      "duration": 6.675,
      "text": "Lihat, buluku adalah yang paling indah di seluruh rimba!' serunya sombong."
    },
    {
      "start": 20.952,
      "end": 27.537,
      "duration": 6.585,
      "text": "Suatu sore, angin kencang menghembuskan duri-duri tajam yang tersangkut di sayapnya."
    },
    {
      "start": 27.537,
      "end": 30.72,
      "duration": 3.183,
      "text": "Miko terjatuh tak berdaya."
    },
    {
      "start": 30.72,
      "end": 39.032,
      "duration": 8.312,
      "text": "Si burung pipit kecil yang sederhana segera datang membawakan air dan mencabut duri itu satu per satu dengan sabar."
    },
    {
      "start": 39.032,
      "end": 46.648,
      "duration": 7.616,
      "text": "Miko menangis terharu dan berbisik: 'Bulu indahku tak ada gunanya tanpa sahabat yang tulus.'"
    },
    {
      "start": 46.648,
      "end": 51.055,
      "duration": 4.407,
      "text": "Keindahan sejati terpancar dari kerendahan hati."
    },
    {
      "start": 51.055,
      "end": 59.547,
      "duration": 8.492,
      "text": "Sekarang, tarik selimut hangatmu, pejamkan matamu ya... selamat tidur, dan mimpi indah."
    }
  ],
