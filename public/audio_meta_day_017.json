    {
      "start": 0.05,
      "end": 7.937,
      "duration": 7.887,
      "text": "Di tepian telaga jernih berhias teratai mekar, Piko si Pelatuk berenang tenang menyusuri riak air yang sejuk."
    },
    {
      "start": 7.937,
      "end": 15.823,
      "duration": 7.887,
      "text": "Jalan yang terbentang di hadapannya memang berbatu dan panjang, namun ia tidak menyerah barang selangkah pun."
    },
    {
      "start": 15.823,
      "end": 22.279,
      "duration": 6.456,
      "text": "Melihat kegigihan itu, Katak datang menyemangati dengan kata-kata penuh kasih."
    },
    {
      "start": 22.279,
      "end": 29.857,
      "duration": 7.577,
      "text": "Saat senja keemasan menyapu langit, keberhasilan manis pun diraih bersama penuh rasa syukur."
    },
    {
      "start": 29.857,
      "end": 35.089,
      "duration": 5.232,
      "text": "Ketukan kecil berulang kali mampu menembus kayu paling keras."
    },
    {
      "start": 35.089,
      "end": 43.542,
      "duration": 8.454,
      "text": "Sekarang, tarik selimut hangatmu, pejamkan matamu ya... selamat tidur, dan mimpi indah."
    }
  ],
