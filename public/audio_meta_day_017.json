    {
      "start": 0.05,
      "end": 7.254,
      "duration": 7.204,
      "text": "Di tepi hutan kenari yang tenang, Piko si Pelatuk sedang duduk memandangi jalan setapak berkabut."
    },
    {
      "start": 7.254,
      "end": 10.501,
      "duration": 3.247,
      "text": "Tiba-tiba, 'Kletuk!'"
    },
    {
      "start": 10.501,
      "end": 16.016,
      "duration": 5.515,
      "text": "Ada sesuatu yang membuat hatinya berdebar cemas saat Katak datang mendekat."
    },
    {
      "start": 16.016,
      "end": 24.393,
      "duration": 8.376,
      "text": "Meski sempat merasa takut, Piko si Pelatuk memilih untuk bersikap jujur dan berbicara dengan penuh kelembutan."
    },
    {
      "start": 24.393,
      "end": 34.87,
      "duration": 10.477,
      "text": "Mendengar kata-katanya yang tulus, Katak tersenyum teduh dan memeluknya hangat: 'Kebaikan hatimu jauh lebih berharga daripada apa pun.'"
    },
    {
      "start": 34.87,
      "end": 40.089,
      "duration": 5.219,
      "text": "Ketukan kecil berulang kali mampu menembus kayu paling keras."
    },
    {
      "start": 40.089,
      "end": 48.632,
      "duration": 8.544,
      "text": "Sekarang, tarik selimut hangatmu, pejamkan matamu ya... selamat tidur, dan mimpi indah."
    }
  ],
