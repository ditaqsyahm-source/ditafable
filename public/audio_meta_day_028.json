  "sentences": [
    {
      "start": 0.05,
      "end": 10.153,
      "duration": 10.103,
      "text": "Di sudut hutan rimba yang dipenuhi aroma bunga mekar, Keluarga Beruang Hutan sedang mengamati indahnya alam dengan tatapan penuh rasa ingin tahu."
    },
    {
      "start": 10.153,
      "end": 17.099,
      "duration": 6.946,
      "text": "Namun saat menjaga titipan berharga di sarang, sebuah keraguan sempat singgah di hatinya."
    },
    {
      "start": 17.099,
      "end": 26.158,
      "duration": 9.059,
      "text": "Alih-alih menyembunyikan rahasia, Keluarga Beruang Hutan segera menemui sahabat rimba dan berkata jujur apa adanya."
    },
    {
      "start": 26.158,
      "end": 36.403,
      "duration": 10.245,
      "text": "sahabat rimba tersenyum teduh dan merangkulnya penuh rasa bangga: 'Kejujuran hatimu jauh lebih berkilau daripada mutiara rimba.'"
    },
    {
      "start": 36.403,
      "end": 40.991,
      "duration": 4.588,
      "text": "Tidurlah nyenyak di bawah naungan kasih sayang semesta."
    },
    {
      "start": 40.991,
      "end": 49.56,
      "duration": 8.57,
      "text": "Sekarang, tarik selimut hangatmu, pejamkan matamu ya... selamat tidur, dan mimpi indah."
    }
  ],
