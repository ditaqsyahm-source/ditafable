    {
      "start": 0.05,
      "end": 9.702,
      "duration": 9.652,
      "text": "Di sudut hutan rimba yang dipenuhi aroma bunga mekar, Robi si Rubah sedang mengamati indahnya alam dengan tatapan penuh rasa ingin tahu."
    },
    {
      "start": 9.702,
      "end": 16.648,
      "duration": 6.946,
      "text": "Namun saat menjaga titipan berharga di sarang, sebuah keraguan sempat singgah di hatinya."
    },
    {
      "start": 16.648,
      "end": 24.805,
      "duration": 8.157,
      "text": "Alih-alih menyembunyikan rahasia, Robi si Rubah segera menemui Angsa dan berkata jujur apa adanya."
    },
    {
      "start": 24.805,
      "end": 34.547,
      "duration": 9.742,
      "text": "Angsa tersenyum teduh dan merangkulnya penuh rasa bangga: 'Kejujuran hatimu jauh lebih berkilau daripada mutiara rimba.'"
    },
    {
      "start": 34.547,
      "end": 39.148,
      "duration": 4.601,
      "text": "Membela kawan yang lemah adalah tanda ksatria sejati."
    },
    {
      "start": 39.148,
      "end": 47.666,
      "duration": 8.518,
      "text": "Sekarang, tarik selimut hangatmu, pejamkan matamu ya... selamat tidur, dan mimpi indah."
    }
  ],
