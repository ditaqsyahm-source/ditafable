  "sentences": [
    {
      "start": 0.05,
      "end": 9.96,
      "duration": 9.91,
      "text": "Di sudut hutan rimba yang dipenuhi aroma bunga mekar, Ziko si Zebra sedang mengamati indahnya alam dengan tatapan penuh rasa ingin tahu."
    },
    {
      "start": 9.96,
      "end": 19.715,
      "duration": 9.755,
      "text": "Meski dianugerahi kelebihan istimewa, Ziko si Zebra belajar bahwa kebanggaan berlebih hanya akan menjauhkan kawan sejati."
    },
    {
      "start": 19.715,
      "end": 27.473,
      "duration": 7.758,
      "text": "Dengan rendah hati, ia mengulurkan salam persahabatan kepada Kuda Poni yang menyambutnya dengan gembira."
    },
    {
      "start": 27.473,
      "end": 35.037,
      "duration": 7.564,
      "text": "Kuda Poni tersenyum bijak: 'Budi pekerti yang santun membuat siapa pun merasa aman di dekatmu.'"
    },
    {
      "start": 35.037,
      "end": 41.184,
      "duration": 6.147,
      "text": "Kelebihan fisik adalah anugerah untuk disyukuri, bukan disombongkan."
    },
    {
      "start": 41.184,
      "end": 49.689,
      "duration": 8.505,
      "text": "Sekarang, tarik selimut hangatmu, pejamkan matamu ya... selamat tidur, dan mimpi indah."
    }
  ],
