  "sentences": [
    {
      "start": 0.05,
      "end": 7.434,
      "duration": 7.384,
      "text": "Di tepi hutan kenari yang tenang, Ziko si Zebra sedang duduk memandangi jalan setapak berkabut."
    },
    {
      "start": 7.434,
      "end": 10.681,
      "duration": 3.247,
      "text": "Tiba-tiba, 'Kletuk!'"
    },
    {
      "start": 10.681,
      "end": 16.455,
      "duration": 5.773,
      "text": "Ada sesuatu yang membuat hatinya berdebar cemas saat Kuda Poni datang mendekat."
    },
    {
      "start": 16.455,
      "end": 24.947,
      "duration": 8.492,
      "text": "Meski sempat merasa takut, Ziko si Zebra memilih untuk bersikap jujur dan berbicara dengan penuh kelembutan."
    },
    {
      "start": 24.947,
      "end": 35.797,
      "duration": 10.851,
      "text": "Mendengar kata-katanya yang tulus, Kuda Poni tersenyum teduh dan memeluknya hangat: 'Kebaikan hatimu jauh lebih berharga daripada apa pun.'"
    },
    {
      "start": 35.797,
      "end": 41.944,
      "duration": 6.147,
      "text": "Kelebihan fisik adalah anugerah untuk disyukuri, bukan disombongkan."
    },
    {
      "start": 41.944,
      "end": 50.462,
      "duration": 8.518,
      "text": "Sekarang, tarik selimut hangatmu, pejamkan matamu ya... selamat tidur, dan mimpi indah."
    }
  ],
