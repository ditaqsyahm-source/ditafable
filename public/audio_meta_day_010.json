  "sentences": [
    {
      "start": 0.05,
      "end": 10.54,
      "duration": 10.49,
      "text": "Di padang rumput hijau yang luas, Sami si semut merah mini terus melangkah membawa sebutir kristal gula yang beratnya tiga kali lipat tubuh mungilnya."
    },
    {
      "start": 10.54,
      "end": 21.274,
      "duration": 10.735,
      "text": "Dari atas tangkai rumput, seekor belalang santai bernyanyi dan tertawa: 'Hai Sami, untuk apa kamu bersusah payah di hari secerah ini?"
    },
    {
      "start": 21.274,
      "end": 24.264,
      "duration": 2.99,
      "text": "Bermainlah bersamaku!'"
    },
    {
      "start": 24.264,
      "end": 35.63,
      "duration": 11.366,
      "text": "Namun Sami tersenyum ramah dan tetap setia melangkah: 'Sedikit demi sedikit, esok saat hujan tiba, keluargaku akan aman di dalam sarang.'"
    },
    {
      "start": 35.63,
      "end": 47.215,
      "duration": 11.585,
      "text": "Ketika badai petir malam harinya mengguncang padang rumput, sang belalang kedinginan di luar, sementara Sami dan kawan-kawannya menikmati kehangatan di sarang bawah tanah."
    },
    {
      "start": 47.215,
      "end": 52.975,
      "duration": 5.76,
      "text": "Kesabaran dan kerja keras hari ini adalah payung terindah untuk hari esok."
    },
    {
      "start": 52.975,
      "end": 61.416,
      "duration": 8.441,
      "text": "Sekarang, tarik selimut hangatmu, pejamkan matamu ya... selamat tidur, dan mimpi indah."
    }
  ],
