    {
      "start": 0.05,
      "end": 7.202,
      "duration": 7.152,
      "text": "Di tepi hutan kenari yang tenang, Sami si Semut sedang duduk memandangi jalan setapak berkabut."
    },
    {
      "start": 7.202,
      "end": 10.449,
      "duration": 3.247,
      "text": "Tiba-tiba, 'Kletuk!'"
    },
    {
      "start": 10.449,
      "end": 15.965,
      "duration": 5.515,
      "text": "Ada sesuatu yang membuat hatinya berdebar cemas saat Belalang datang mendekat."
    },
    {
      "start": 15.965,
      "end": 24.264,
      "duration": 8.299,
      "text": "Meski sempat merasa takut, Sami si Semut memilih untuk bersikap jujur dan berbicara dengan penuh kelembutan."
    },
    {
      "start": 24.264,
      "end": 34.87,
      "duration": 10.606,
      "text": "Mendengar kata-katanya yang tulus, Belalang tersenyum teduh dan memeluknya hangat: 'Kebaikan hatimu jauh lebih berharga daripada apa pun.'"
    },
    {
      "start": 34.87,
      "end": 40.0,
      "duration": 5.13,
      "text": "Kerja keras di masa muda menjamin kehangatan di musim dingin."
    },
    {
      "start": 40.0,
      "end": 48.594,
      "duration": 8.594,
      "text": "Sekarang, tarik selimut hangatmu, pejamkan matamu ya... selamat tidur, dan mimpi indah."
    }
  ],
