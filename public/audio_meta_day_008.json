  "sentences": [
    {
      "start": 0.05,
      "end": 7.266,
      "duration": 7.216,
      "text": "Di tepi hutan kenari yang tenang, Loli si Tupai sedang duduk memandangi jalan setapak berkabut."
    },
    {
      "start": 7.266,
      "end": 10.514,
      "duration": 3.247,
      "text": "Tiba-tiba, 'Kletuk!'"
    },
    {
      "start": 10.514,
      "end": 16.442,
      "duration": 5.928,
      "text": "Ada sesuatu yang membuat hatinya berdebar cemas saat Nenek Kelinci datang mendekat."
    },
    {
      "start": 16.442,
      "end": 24.844,
      "duration": 8.402,
      "text": "Meski sempat merasa takut, Loli si Tupai memilih untuk bersikap jujur dan berbicara dengan penuh kelembutan."
    },
    {
      "start": 24.844,
      "end": 35.862,
      "duration": 11.018,
      "text": "Mendengar kata-katanya yang tulus, Nenek Kelinci tersenyum teduh dan memeluknya hangat: 'Kebaikan hatimu jauh lebih berharga daripada apa pun.'"
    },
    {
      "start": 35.862,
      "end": 42.047,
      "duration": 6.186,
      "text": "Menjaga amanah makanan simpanan di musim gugur membawa berkah persahabatan."
    },
    {
      "start": 42.047,
      "end": 50.514,
      "duration": 8.466,
      "text": "Sekarang, tarik selimut hangatmu, pejamkan matamu ya... selamat tidur, dan mimpi indah."
    }
  ],
