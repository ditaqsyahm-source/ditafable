  "sentences": [
    {
      "start": 0.05,
      "end": 7.55,
      "duration": 7.5,
      "text": "Di tepi hutan kenari yang tenang, Keluarga Burung Pipit sedang duduk memandangi jalan setapak berkabut."
    },
    {
      "start": 7.55,
      "end": 10.797,
      "duration": 3.247,
      "text": "Tiba-tiba, 'Kletuk!'"
    },
    {
      "start": 10.797,
      "end": 17.047,
      "duration": 6.25,
      "text": "Ada sesuatu yang membuat hatinya berdebar cemas saat sahabatnya di hutan datang mendekat."
    },
    {
      "start": 17.047,
      "end": 25.411,
      "duration": 8.363,
      "text": "Meski sempat merasa takut, Keluarga Burung memilih untuk bersikap jujur dan berbicara dengan penuh kelembutan."
    },
    {
      "start": 25.411,
      "end": 36.79,
      "duration": 11.379,
      "text": "Mendengar kata-katanya yang tulus, sahabatnya di hutan tersenyum teduh dan memeluknya hangat: 'Kebaikan hatimu jauh lebih berharga daripada apa pun.'"
    },
    {
      "start": 36.79,
      "end": 42.099,
      "duration": 5.309,
      "text": "Bersyukur atas rezeki hari ini membuat mimpi malam terasa damai."
    },
    {
      "start": 42.099,
      "end": 50.669,
      "duration": 8.57,
      "text": "Sekarang, tarik selimut hangatmu, pejamkan matamu ya... selamat tidur, dan mimpi indah."
    }
  ],
