    {
      "start": 0.05,
      "end": 7.988,
      "duration": 7.938,
      "text": "Di hamparan padang rumput hijau berembun segar, Kancil melangkah riang menikmati hangatnya cahaya mentari."
    },
    {
      "start": 7.988,
      "end": 14.934,
      "duration": 6.946,
      "text": "Namun saat menjaga titipan berharga di sarang, sebuah keraguan sempat singgah di hatinya."
    },
    {
      "start": 14.934,
      "end": 23.065,
      "duration": 8.131,
      "text": "Alih-alih menyembunyikan rahasia, Kancil segera menemui Kancil Cilik dan berkata jujur apa adanya."
    },
    {
      "start": 23.065,
      "end": 33.169,
      "duration": 10.103,
      "text": "Kancil Cilik tersenyum teduh dan merangkulnya penuh rasa bangga: 'Kejujuran hatimu jauh lebih berkilau daripada mutiara rimba.'"
    },
    {
      "start": 33.169,
      "end": 38.774,
      "duration": 5.606,
      "text": "Kejujuran dalam proses bertumbuh lebih penting daripada hasil instan."
    },
    {
      "start": 38.774,
      "end": 47.305,
      "duration": 8.531,
      "text": "Sekarang, tarik selimut hangatmu, pejamkan matamu ya... selamat tidur, dan mimpi indah."
    }
  ],
