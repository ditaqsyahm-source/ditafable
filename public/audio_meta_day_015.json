    {
      "start": 0.05,
      "end": 6.828,
      "duration": 6.778,
      "text": "Di tepi hutan kenari yang tenang, Kancil sedang duduk memandangi jalan setapak berkabut."
    },
    {
      "start": 6.828,
      "end": 10.063,
      "duration": 3.235,
      "text": "Tiba-tiba, 'Kletuk!'"
    },
    {
      "start": 10.063,
      "end": 15.926,
      "duration": 5.863,
      "text": "Ada sesuatu yang membuat hatinya berdebar cemas saat Kancil Cilik datang mendekat."
    },
    {
      "start": 15.926,
      "end": 23.723,
      "duration": 7.796,
      "text": "Meski sempat merasa takut, Kancil memilih untuk bersikap jujur dan berbicara dengan penuh kelembutan."
    },
    {
      "start": 23.723,
      "end": 34.689,
      "duration": 10.966,
      "text": "Mendengar kata-katanya yang tulus, Kancil Cilik tersenyum teduh dan memeluknya hangat: 'Kebaikan hatimu jauh lebih berharga daripada apa pun.'"
    },
    {
      "start": 34.689,
      "end": 40.295,
      "duration": 5.606,
      "text": "Kejujuran dalam proses bertumbuh lebih penting daripada hasil instan."
    },
    {
      "start": 40.295,
      "end": 48.826,
      "duration": 8.531,
      "text": "Sekarang, tarik selimut hangatmu, pejamkan matamu ya... selamat tidur, dan mimpi indah."
    }
  ],
