  "sentences": [
    {
      "start": 0.05,
      "end": 8.426,
      "duration": 8.376,
      "text": "Di hamparan padang rumput hijau berembun segar, Kelo si Kelelawar melangkah riang menikmati hangatnya cahaya mentari."
    },
    {
      "start": 8.426,
      "end": 18.774,
      "duration": 10.348,
      "text": "Ketika melihat Kiki Kelinci sedang kelelahan dan membutuhkan pertolongan, Kelo si Kelelawar tidak ragu sedetik pun untuk berbagi apa yang dimilikinya."
    },
    {
      "start": 18.774,
      "end": 25.256,
      "duration": 6.482,
      "text": "Keduanya pun saling bertukar senyum hangat di bawah naungan dedaunan rimba yang damai."
    },
    {
      "start": 25.256,
      "end": 33.632,
      "duration": 8.376,
      "text": "Kiki Kelinci berbisik penuh rasa haru: 'Tangan yang memberi selalu merasakan kehangatan yang tak pernah padam.'"
    },
    {
      "start": 33.632,
      "end": 39.251,
      "duration": 5.619,
      "text": "Makhluk malam pun memiliki cinta kasih dan ketulusan menjaga sesama."
    },
    {
      "start": 39.251,
      "end": 47.808,
      "duration": 8.557,
      "text": "Sekarang, tarik selimut hangatmu, pejamkan matamu ya... selamat tidur, dan mimpi indah."
    }
  ],
