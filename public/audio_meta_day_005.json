  "sentences": [
    {
      "start": 0.05,
      "end": 8.143,
      "duration": 8.093,
      "text": "Saat amarahmu membakar seperti api di dalam dada, jangan biarkan cakar tajammu merusak segalanya."
    },
    {
      "start": 8.143,
      "end": 14.328,
      "duration": 6.186,
      "text": "Balu si beruang cilik menggeram marah karena menara batunya roboh tertiup angin."
    },
    {
      "start": 14.328,
      "end": 17.975,
      "duration": 3.647,
      "text": "Ia ingin membanting semua mainannya."
    },
    {
      "start": 17.975,
      "end": 33.388,
      "duration": 15.412,
      "text": "Kakek Beruang perlahan duduk di sampingnya, meletakkan tangan hangatnya di dada Balu, lalu berbisik lembut: 'Tarik napas dalam seperti mencium wangi bunga hutan, lalu hembuskan pelan seperti meniup daun kering.'"
    },
    {
      "start": 33.388,
      "end": 36.699,
      "duration": 3.312,
      "text": "Balu menarik napas tiga kali."
    },
    {
      "start": 36.699,
      "end": 43.078,
      "duration": 6.379,
      "text": "Perlahan, detak jantungnya mereda dan amarahnya larut bagai embun pagi."
    },
    {
      "start": 43.078,
      "end": 47.009,
      "duration": 3.93,
      "text": "Marah itu tamu sementara, Balu."
    },
    {
      "start": 47.009,
      "end": 51.493,
      "duration": 4.485,
      "text": "Jangan biarkan ia merusak kedamaian hatimu.'"
    },
    {
      "start": 51.493,
      "end": 55.192,
      "duration": 3.698,
      "text": "Ketenangan adalah kekuatan terbesarmu."
    },
    {
      "start": 55.192,
      "end": 63.71,
      "duration": 8.518,
      "text": "Sekarang, tarik selimut hangatmu, pejamkan matamu ya... selamat tidur, dan mimpi indah."
    }
  ],
