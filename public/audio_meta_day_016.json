    {
      "start": 0.05,
      "end": 9.393,
      "duration": 9.343,
      "text": "Di atas dahan pohon kenari tua yang rimbun dan teduh, Owi si Burung Hantu melompat lincah sambil menyapa hembusan angin semilir."
    },
    {
      "start": 9.393,
      "end": 19.47,
      "duration": 10.077,
      "text": "Ketika melihat Rusa sedang kelelahan dan membutuhkan pertolongan, Owi si Burung Hantu tidak ragu sedetik pun untuk berbagi apa yang dimilikinya."
    },
    {
      "start": 19.47,
      "end": 25.965,
      "duration": 6.495,
      "text": "Keduanya pun saling bertukar senyum hangat di bawah naungan dedaunan rimba yang damai."
    },
    {
      "start": 25.965,
      "end": 33.903,
      "duration": 7.938,
      "text": "Rusa berbisik penuh rasa haru: 'Tangan yang memberi selalu merasakan kehangatan yang tak pernah padam.'"
    },
    {
      "start": 33.903,
      "end": 39.109,
      "duration": 5.206,
      "text": "Mendengarkan dengan penuh empati adalah obat bagi luka hati."
    },
    {
      "start": 39.109,
      "end": 47.537,
      "duration": 8.428,
      "text": "Sekarang, tarik selimut hangatmu, pejamkan matamu ya... selamat tidur, dan mimpi indah."
    }
  ],
