  "sentences": [
    {
      "start": 0.05,
      "end": 7.563,
      "duration": 7.513,
      "text": "Di tepi hutan kenari yang tenang, Owi si Burung Hantu sedang duduk memandangi jalan setapak berkabut."
    },
    {
      "start": 7.563,
      "end": 10.81,
      "duration": 3.247,
      "text": "Tiba-tiba, 'Kletuk!'"
    },
    {
      "start": 10.81,
      "end": 16.352,
      "duration": 5.541,
      "text": "Ada sesuatu yang membuat hatinya berdebar cemas saat Rusa datang mendekat."
    },
    {
      "start": 16.352,
      "end": 24.612,
      "duration": 8.26,
      "text": "Meski sempat merasa takut, Owi si Burung memilih untuk bersikap jujur dan berbicara dengan penuh kelembutan."
    },
    {
      "start": 24.612,
      "end": 35.23,
      "duration": 10.619,
      "text": "Mendengar kata-katanya yang tulus, Rusa tersenyum teduh dan memeluknya hangat: 'Kebaikan hatimu jauh lebih berharga daripada apa pun.'"
    },
    {
      "start": 35.23,
      "end": 40.437,
      "duration": 5.206,
      "text": "Mendengarkan dengan penuh empati adalah obat bagi luka hati."
    },
    {
      "start": 40.437,
      "end": 48.839,
      "duration": 8.402,
      "text": "Sekarang, tarik selimut hangatmu, pejamkan matamu ya... selamat tidur, dan mimpi indah."
    }
  ],
