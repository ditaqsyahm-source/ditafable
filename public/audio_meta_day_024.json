    {
      "start": 0.05,
      "end": 9.689,
      "duration": 9.639,
      "text": "Di sudut hutan rimba yang dipenuhi aroma bunga mekar, Uli si Ulat sedang mengamati indahnya alam dengan tatapan penuh rasa ingin tahu."
    },
    {
      "start": 9.689,
      "end": 17.537,
      "duration": 7.848,
      "text": "Jalan yang terbentang di hadapannya memang berbatu dan panjang, namun ia tidak menyerah barang selangkah pun."
    },
    {
      "start": 17.537,
      "end": 24.148,
      "duration": 6.611,
      "text": "Melihat kegigihan itu, Belalang datang menyemangati dengan kata-kata penuh kasih."
    },
    {
      "start": 24.148,
      "end": 31.712,
      "duration": 7.564,
      "text": "Saat senja keemasan menyapu langit, keberhasilan manis pun diraih bersama penuh rasa syukur."
    },
    {
      "start": 31.712,
      "end": 37.487,
      "duration": 5.774,
      "text": "Perubahan indah membutuhkan masa penantian dan kesabaran dalam kepompong."
    },
    {
      "start": 37.487,
      "end": 46.042,
      "duration": 8.556,
      "text": "Sekarang, tarik selimut hangatmu, pejamkan matamu ya... selamat tidur, dan mimpi indah."
    }
  ],
