  "sentences": [
    {
      "start": 0.05,
      "end": 8.478,
      "duration": 8.428,
      "text": "Di hamparan padang rumput hijau berembun segar, Tiko si Tikus melangkah riang menikmati hangatnya cahaya mentari."
    },
    {
      "start": 8.478,
      "end": 16.97,
      "duration": 8.492,
      "text": "Ketika tugas besar terasa berat bila dipikul sendiri, Singa Rimba hadir menawarkan bantuan dengan riang gembira."
    },
    {
      "start": 16.97,
      "end": 23.388,
      "duration": 6.418,
      "text": "Bahu-membahu mereka menyatukan kekuatan hingga pekerjaan selesai dengan sempurna."
    },
    {
      "start": 23.388,
      "end": 31.21,
      "duration": 7.822,
      "text": "Di bawah langit malam bertabur bintang gemerlap, hati mereka dipenuhi rasa aman dan persaudaraan yang erat."
    },
    {
      "start": 31.21,
      "end": 36.519,
      "duration": 5.309,
      "text": "Bantuan dari makhluk terkecil mampu melepaskan jeratan terbesar."
    },
    {
      "start": 36.519,
      "end": 45.011,
      "duration": 8.492,
      "text": "Sekarang, tarik selimut hangatmu, pejamkan matamu ya... selamat tidur, dan mimpi indah."
    }
  ],
