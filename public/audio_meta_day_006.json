  "sentences": [
    {
      "start": 0.05,
      "end": 8.156,
      "duration": 8.106,
      "text": "Satu ranting pohon mudah sekali patah, tapi tahukah kamu apa yang terjadi jika seratus ranting disatukan?"
    },
    {
      "start": 8.156,
      "end": 16.403,
      "duration": 8.247,
      "text": "Tupi si tupai lincah ingin menyeberangi sungai deras untuk memetik kenari matang, tapi ia tak bisa berenang."
    },
    {
      "start": 16.403,
      "end": 23.877,
      "duration": 7.474,
      "text": "Di tepi sungai, Bobi si berang-berang punya kayu gelondongan kokoh, tapi tak bisa memanjat."
    },
    {
      "start": 23.877,
      "end": 27.924,
      "duration": 4.046,
      "text": "Mereka berhenti saling menyombongkan kelebihan."
    },
    {
      "start": 27.924,
      "end": 36.042,
      "duration": 8.119,
      "text": "Tupi melompat gesit membawa tali ke puncak dahan, sementara Bobi menyusun batang kayu di dasar sungai."
    },
    {
      "start": 36.042,
      "end": 40.565,
      "duration": 4.523,
      "text": "Dalam sekejap, jembatan kokoh berdiri megah."
    },
    {
      "start": 40.565,
      "end": 50.604,
      "duration": 10.039,
      "text": "Burung Hantu Bijak berseru: 'Saat dua sahabat bergandeng tangan, rintangan terbesar pun berubah menjadi jalan kebahagiaan.'"
    },
    {
      "start": 50.604,
      "end": 53.993,
      "duration": 3.389,
      "text": "Ingatlah rahasia persahabatan ini..."
    }
  ],
