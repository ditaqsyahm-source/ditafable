  "sentences": [
    {
      "start": 0.05,
      "end": 7.756,
      "duration": 7.706,
      "text": "Bara adalah serigala kecil berbulu kelabu yang sering dijauhi hewan-hewan lain karena taringnya yang runcing."
    },
    {
      "start": 7.756,
      "end": 15.462,
      "duration": 7.706,
      "text": "Suatu senja di tepi hutan berkabut, Bara mendengar suara tangis cicit pelan di balik semak berduri."
    },
    {
      "start": 15.462,
      "end": 22.06,
      "duration": 6.598,
      "text": "Rupanya, Moli si anak domba tersesat dan tak tahu jalan pulang ke padang rumput."
    },
    {
      "start": 22.06,
      "end": 26.777,
      "duration": 4.716,
      "text": "Meski tubuhnya lelah, Bara tidak menakuti Moli."
    },
    {
      "start": 26.777,
      "end": 37.138,
      "duration": 10.361,
      "text": "Ia justru berjalan di depan menerangi jalan setapak dan membiarkan Moli berpegangan pada ekor lebatnya yang hangat sampai tiba di pelukan induknya."
    },
    {
      "start": 37.138,
      "end": 45.823,
      "duration": 8.686,
      "text": "Induk domba meneteskan air mata bahagia: 'Terima kasih serigala yang baik, kasihmu begitu tulus.'"
    },
    {
      "start": 45.823,
      "end": 53.929,
      "duration": 8.106,
      "text": "Jangan pernah menilai kebaikan seseorang hanya dari rupanya, karena cinta sejati tinggal di dalam hati."
    },
    {
      "start": 53.929,
      "end": 62.37,
      "duration": 8.441,
      "text": "Sekarang, tarik selimut hangatmu, pejamkan matamu ya... selamat tidur, dan mimpi indah."
    }
  ],
