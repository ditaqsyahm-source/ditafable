  "sentences": [
    {
      "start": 0.05,
      "end": 7.46,
      "duration": 7.41,
      "text": "Di tepi hutan kenari yang tenang, Bara si Serigala sedang duduk memandangi jalan setapak berkabut."
    },
    {
      "start": 7.46,
      "end": 10.72,
      "duration": 3.26,
      "text": "Tiba-tiba, 'Kletuk!'"
    },
    {
      "start": 10.72,
      "end": 17.073,
      "duration": 6.353,
      "text": "Ada sesuatu yang membuat hatinya berdebar cemas saat Moli si Anak Domba datang mendekat."
    },
    {
      "start": 17.073,
      "end": 25.604,
      "duration": 8.531,
      "text": "Meski sempat merasa takut, Bara si Serigala memilih untuk bersikap jujur dan berbicara dengan penuh kelembutan."
    },
    {
      "start": 25.604,
      "end": 37.125,
      "duration": 11.521,
      "text": "Mendengar kata-katanya yang tulus, Moli si Anak Domba tersenyum teduh dan memeluknya hangat: 'Kebaikan hatimu jauh lebih berharga daripada apa pun.'"
    },
    {
      "start": 37.125,
      "end": 42.408,
      "duration": 5.284,
      "text": "Kasih sayang menembus batas perbedaan jenis dan prasangka lama."
    },
    {
      "start": 42.408,
      "end": 50.926,
      "duration": 8.518,
      "text": "Sekarang, tarik selimut hangatmu, pejamkan matamu ya... selamat tidur, dan mimpi indah."
    }
  ],
