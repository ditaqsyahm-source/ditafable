  "sentences": [
    {
      "start": 0.05,
      "end": 7.189,
      "duration": 7.139,
      "text": "Semua hewan hutan menjauhi Duri si landak kecil, sampai hujan badai datang malam itu."
    },
    {
      "start": 7.189,
      "end": 13.413,
      "duration": 6.224,
      "text": "Tubuhnya yang penuh duri runcing membuat kawan-kawannya takut terluka dan enggan mendekat."
    },
    {
      "start": 13.413,
      "end": 18.98,
      "duration": 5.567,
      "text": "Duri sering merasa sedih dan menangis sendirian di dalam sarangnya yang sepi."
    },
    {
      "start": 18.98,
      "end": 26.622,
      "duration": 7.642,
      "text": "Namun saat angin kencang merobohkan sarang lebah madu ke tanah basah, Duri tidak ragu sedikit pun."
    },
    {
      "start": 26.622,
      "end": 36.712,
      "duration": 10.09,
      "text": "Ia segera melengkungkan tubuhnya di atas sarang rapuh itu, rela menahan dinginnya air hujan demi melindungi bayi-bayi lebah sepanjang malam."
    },
    {
      "start": 36.712,
      "end": 46.609,
      "duration": 9.897,
      "text": "Saat fajar menyingsing indah, Ratu Lebah berbisik penuh haru: 'Duri di punggungmu tajam, tapi hatimu selembut sutra.'"
    },
    {
      "start": 46.609,
      "end": 52.292,
      "duration": 5.683,
      "text": "Jangan pernah menilai indahnya kebaikan hanya dari penampilan luarnya."
    },
    {
      "start": 52.292,
      "end": 56.699,
      "duration": 4.407,
      "text": "Ingatlah kehangatan ini setiap kali kamu mendengar..."
    }
  ],
