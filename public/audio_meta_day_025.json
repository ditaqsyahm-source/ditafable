  "sentences": [
    {
      "start": 0.05,
      "end": 7.962,
      "duration": 7.912,
      "text": "Di tepian telaga jernih berhias teratai mekar, Diko si Bebek berenang tenang menyusuri riak air yang sejuk."
    },
    {
      "start": 7.962,
      "end": 17.511,
      "duration": 9.549,
      "text": "Meski dianugerahi kelebihan istimewa, Diko si Bebek belajar bahwa kebanggaan berlebih hanya akan menjauhkan kawan sejati."
    },
    {
      "start": 17.511,
      "end": 25.475,
      "duration": 7.964,
      "text": "Dengan rendah hati, ia mengulurkan salam persahabatan kepada Angsa Putih yang menyambutnya dengan gembira."
    },
    {
      "start": 25.475,
      "end": 33.078,
      "duration": 7.603,
      "text": "Angsa Putih tersenyum bijak: 'Budi pekerti yang santun membuat siapa pun merasa aman di dekatmu.'"
    },
    {
      "start": 33.078,
      "end": 38.465,
      "duration": 5.387,
      "text": "Rasa syukur membuat warna bulu yang kusam tampak berkilau menawan."
    },
    {
      "start": 38.465,
      "end": 47.035,
      "duration": 8.57,
      "text": "Sekarang, tarik selimut hangatmu, pejamkan matamu ya... selamat tidur, dan mimpi indah."
    }
  ],
