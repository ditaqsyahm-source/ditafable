  "sentences": [
    {
      "start": 0.05,
      "end": 9.702,
      "duration": 9.652,
      "text": "Di sudut hutan rimba yang dipenuhi aroma bunga mekar, Ciko si Monyet sedang mengamati indahnya alam dengan tatapan penuh rasa ingin tahu."
    },
    {
      "start": 9.702,
      "end": 20.411,
      "duration": 10.709,
      "text": "Ketika kesalahpahaman kecil sempat membuat dada terasa sesak, Ciko si Monyet memilih menarik napas panjang dan membasuh rasa kesalnya dengan ketenangan."
    },
    {
      "start": 20.411,
      "end": 27.06,
      "duration": 6.649,
      "text": "Dengan lapang dada, ia mendengarkan Ibu Kera dan saling memaafkan dengan tulus."
    },
    {
      "start": 27.06,
      "end": 34.238,
      "duration": 7.178,
      "text": "Suasana rimba pun kembali tenteram, ditemani alunan desau angin yang menyejukkan kalbu."
    },
    {
      "start": 34.238,
      "end": 39.599,
      "duration": 5.361,
      "text": "Sabar menunggu saat yang tepat mendatangkan rasa buah yang termanis."
    },
    {
      "start": 39.599,
      "end": 48.13,
      "duration": 8.531,
      "text": "Sekarang, tarik selimut hangatmu, pejamkan matamu ya... selamat tidur, dan mimpi indah."
    }
  ],
