  "sentences": [
    {
      "start": 0.05,
      "end": 7.176,
      "duration": 7.126,
      "text": "Di tepi hutan kenari yang tenang, Ciko si Monyet sedang duduk memandangi jalan setapak berkabut."
    },
    {
      "start": 7.176,
      "end": 10.424,
      "duration": 3.247,
      "text": "Tiba-tiba, 'Kletuk!'"
    },
    {
      "start": 10.424,
      "end": 16.029,
      "duration": 5.606,
      "text": "Ada sesuatu yang membuat hatinya berdebar cemas saat Ibu Kera datang mendekat."
    },
    {
      "start": 16.029,
      "end": 24.264,
      "duration": 8.235,
      "text": "Meski sempat merasa takut, Ciko si Monyet memilih untuk bersikap jujur dan berbicara dengan penuh kelembutan."
    },
    {
      "start": 24.264,
      "end": 35.05,
      "duration": 10.786,
      "text": "Mendengar kata-katanya yang tulus, Ibu Kera tersenyum teduh dan memeluknya hangat: 'Kebaikan hatimu jauh lebih berharga daripada apa pun.'"
    },
    {
      "start": 35.05,
      "end": 40.411,
      "duration": 5.361,
      "text": "Sabar menunggu saat yang tepat mendatangkan rasa buah yang termanis."
    },
    {
      "start": 40.411,
      "end": 48.929,
      "duration": 8.518,
      "text": "Sekarang, tarik selimut hangatmu, pejamkan matamu ya... selamat tidur, dan mimpi indah."
    }
  ],
