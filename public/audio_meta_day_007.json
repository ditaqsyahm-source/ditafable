  "sentences": [
    {
      "start": 0.05,
      "end": 7.382,
      "duration": 7.332,
      "text": "Malam telah turun menyelimuti dahan pohon kenari, dan bintang kecil mulai berkedip lembut di langit."
    },
    {
      "start": 7.382,
      "end": 12.949,
      "duration": 5.567,
      "text": "Roni si rusa kecil merebahkan kepalanya di atas lumut hijau yang empuk."
    },
    {
      "start": 12.949,
      "end": 20.578,
      "duration": 7.629,
      "text": "Ibu, apakah besok hutan masih seindah hari ini?' bisiknya dengan mata yang mulai mengantuk."
    },
    {
      "start": 20.578,
      "end": 33.014,
      "duration": 12.436,
      "text": "Ibu Rusa mengelus kepalanya lembut dan berbisik: 'Selama hatimu dipenuhi rasa syukur dan kasih sayang, setiap fajar akan membawa keajaiban baru, sayangku.'"
    },
    {
      "start": 33.014,
      "end": 39.934,
      "duration": 6.92,
      "text": "Ratusan kunang-kunang menyalakan lenteranya, menyanyikan simfoni angin malam yang syahdu."
    },
    {
      "start": 39.934,
      "end": 44.857,
      "duration": 4.923,
      "text": "Pejamkan matamu, lepaskan semua lelah hari ini."
    },
    {
      "start": 44.857,
      "end": 51.068,
      "duration": 6.211,
      "text": "Kamu anak yang hebat, berani, dan selalu dicintai seutuhnya."
    },
    {
      "start": 51.068,
      "end": 59.547,
      "duration": 8.479,
      "text": "Sekarang, tarik selimut hangatmu, pejamkan matamu ya... selamat tidur, dan mimpi indah."
    }
  ],
