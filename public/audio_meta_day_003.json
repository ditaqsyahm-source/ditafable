  "sentences": [
    {
      "start": 0.05,
      "end": 6.868,
      "duration": 6.818,
      "text": "Kelinci melompat cepat sambil menertawakan kura-kura kecil yang berjalan selangkah demi selangkah."
    },
    {
      "start": 6.868,
      "end": 14.161,
      "duration": 7.293,
      "text": "Hei Kuki, danau itu terlalu luas, kamu takkan pernah sampai sebelum malam!'"
    },
    {
      "start": 14.161,
      "end": 19.096,
      "duration": 4.936,
      "text": "Namun Kuki tetap tenang dan tidak menghiraukan ejekan itu."
    },
    {
      "start": 19.096,
      "end": 23.297,
      "duration": 4.201,
      "text": "Ia hanya fokus pada satu langkah di depannya."
    },
    {
      "start": 23.297,
      "end": 28.388,
      "duration": 5.09,
      "text": "Satu langkah, dua langkah, lalu tiga langkah."
    },
    {
      "start": 28.388,
      "end": 34.998,
      "duration": 6.611,
      "text": "Di tengah jalan, kelinci tertidur pulas karena merasa sudah terlalu jauh di depan."
    },
    {
      "start": 34.998,
      "end": 42.305,
      "duration": 7.307,
      "text": "Saat matahari terbenam menyinari danau teratai, Kuki telah tersenyum damai di seberang pulau."
    },
    {
      "start": 42.305,
      "end": 51.364,
      "duration": 9.059,
      "text": "Guru Bangau berbisik bijak: 'Bukan siapa yang paling cepat melompat, tapi siapa yang setia melangkah tanpa henti.'"
    },
    {
      "start": 51.364,
      "end": 55.527,
      "duration": 4.162,
      "text": "Kesabaran selalu menuntunmu pulang dengan selamat."
    },
    {
      "start": 55.527,
      "end": 58.491,
      "duration": 2.964,
      "text": "Ingatlah perjuangan Kuki saat..."
    }
  ],
