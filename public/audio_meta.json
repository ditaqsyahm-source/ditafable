  "sentences": [
    {
      "start": 0.05,
      "end": 4.857,
      "duration": 4.807,
      "text": "Jangan sembunyikan apel yang sudah terbelah itu di balik semak!"
    },
    {
      "start": 4.857,
      "end": 12.782,
      "duration": 7.925,
      "text": "Kancil kecil bernama Ciko gemetar saat apel emas kesayangan kakek beruang pecah karena kecerobohannya."
    },
    {
      "start": 12.782,
      "end": 16.339,
      "duration": 3.557,
      "text": "Ia sempat ingin lari dan berbohong."
    },
    {
      "start": 16.339,
      "end": 25.707,
      "duration": 9.369,
      "text": "Tapi di dalam dadanya, detak jantungnya berbisik bahwa rasa bersalah itu terasa jauh lebih berat daripada hukuman apapun."
    },
    {
      "start": 25.707,
      "end": 36.107,
      "duration": 10.399,
      "text": "Dengan napas pelan, Ciko menghampiri kakek beruang dan berkata jujur: 'Kakek, Ciko minta maaf, Ciko yang memecahkannya.'"
    },
    {
      "start": 36.107,
      "end": 45.656,
      "duration": 9.549,
      "text": "Kakek beruang tersenyum hangat, lalu memeluknya erat: 'Mengakui kesalahan butuh keberanian ksatria sejati, Ciko.'"
    },
    {
      "start": 45.656,
      "end": 51.005,
      "duration": 5.349,
      "text": "Karena kejujuran selalu membasuh rasa takut menjadi rasa tenang."
    },
    {
      "start": 51.005,
      "end": 56.081,
      "duration": 5.076,
      "text": "Maka malam ini sebelum tidur, ingatlah selalu pesan ini..."
    }
  ],
