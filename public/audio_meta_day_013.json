    {
      "start": 0.05,
      "end": 9.277,
      "duration": 9.227,
      "text": "Di atas dahan pohon kenari tua yang rimbun dan teduh, Hewan Hutan Rimba melompat lincah sambil menyapa hembusan angin semilir."
    },
    {
      "start": 9.277,
      "end": 17.949,
      "duration": 8.673,
      "text": "Ketika tugas besar terasa berat bila dipikul sendiri, sahabat rimba hadir menawarkan bantuan dengan riang gembira."
    },
    {
      "start": 17.949,
      "end": 24.38,
      "duration": 6.43,
      "text": "Bahu-membahu mereka menyatukan kekuatan hingga pekerjaan selesai dengan sempurna."
    },
    {
      "start": 24.38,
      "end": 32.202,
      "duration": 7.822,
      "text": "Di bawah langit malam bertabur bintang gemerlap, hati mereka dipenuhi rasa aman dan persaudaraan yang erat."
    },
    {
      "start": 32.202,
      "end": 37.395,
      "duration": 5.193,
      "text": "Berbagi hidangan melipatgandakan rasa manis dan keakraban."
    },
    {
      "start": 37.395,
      "end": 45.888,
      "duration": 8.492,
      "text": "Sekarang, tarik selimut hangatmu, pejamkan matamu ya... selamat tidur, dan mimpi indah."
    }
  ],
