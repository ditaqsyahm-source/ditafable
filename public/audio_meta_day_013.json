  "sentences": [
    {
      "start": 0.05,
      "end": 7.486,
      "duration": 7.436,
      "text": "Di tepi hutan kenari yang tenang, Hewan Hutan Rimba sedang duduk memandangi jalan setapak berkabut."
    },
    {
      "start": 7.486,
      "end": 10.759,
      "duration": 3.273,
      "text": "Tiba-tiba, 'Kletuk!'"
    },
    {
      "start": 10.759,
      "end": 16.996,
      "duration": 6.237,
      "text": "Ada sesuatu yang membuat hatinya berdebar cemas saat sahabatnya di hutan datang mendekat."
    },
    {
      "start": 16.996,
      "end": 25.063,
      "duration": 8.067,
      "text": "Meski sempat merasa takut, Hewan Hutan memilih untuk bersikap jujur dan berbicara dengan penuh kelembutan."
    },
    {
      "start": 25.063,
      "end": 36.455,
      "duration": 11.392,
      "text": "Mendengar kata-katanya yang tulus, sahabatnya di hutan tersenyum teduh dan memeluknya hangat: 'Kebaikan hatimu jauh lebih berharga daripada apa pun.'"
    },
    {
      "start": 36.455,
      "end": 41.661,
      "duration": 5.206,
      "text": "Berbagi hidangan melipatgandakan rasa manis dan keakraban."
    },
    {
      "start": 41.661,
      "end": 50.166,
      "duration": 8.505,
      "text": "Sekarang, tarik selimut hangatmu, pejamkan matamu ya... selamat tidur, dan mimpi indah."
    }
  ],
