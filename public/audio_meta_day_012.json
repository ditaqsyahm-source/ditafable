  "sentences": [
    {
      "start": 0.05,
      "end": 8.581,
      "duration": 8.531,
      "text": "Di tepi kolam kenari yang jernih berkilau, Milo si kucing hutan berbulu belang sedang asyik bermain dengan kupu-kupu."
    },
    {
      "start": 8.581,
      "end": 17.808,
      "duration": 9.227,
      "text": "Tanpa sengaja, cakarnya menyenggol tumpukan kerikil hias hingga berjatuhan mengotori air tempat Ikan Mas berenang tenang."
    },
    {
      "start": 17.808,
      "end": 24.096,
      "duration": 6.289,
      "text": "Air telaga pun menjadi keruh dan Ikan Mas terkejut bersembunyi di balik teratai."
    },
    {
      "start": 24.096,
      "end": 29.174,
      "duration": 5.077,
      "text": "Milo merasa sangat bersalah dan tertunduk malu di tepi kolam."
    },
    {
      "start": 29.174,
      "end": 36.919,
      "duration": 7.745,
      "text": "Kakek Kura-Kura berenang mendekat dan berkata lembut: 'Tak ada persahabatan yang tak pernah salah, Milo."
    },
    {
      "start": 36.919,
      "end": 41.687,
      "duration": 4.768,
      "text": "Yang terpenting adalah kemauan membersihkannya kembali.'"
    },
    {
      "start": 41.687,
      "end": 48.349,
      "duration": 6.662,
      "text": "Milo lalu dengan sabar memungut kerikil itu satu per satu sampai air kembali bening."
    },
    {
      "start": 48.349,
      "end": 54.161,
      "duration": 5.812,
      "text": "Memaafkan dan memperbaiki kesalahan membuka pintu persaudaraan yang abadi."
    },
    {
      "start": 54.161,
      "end": 62.486,
      "duration": 8.325,
      "text": "Sekarang, tarik selimut hangatmu, pejamkan matamu ya... selamat tidur, dan mimpi indah."
    }
  ],
