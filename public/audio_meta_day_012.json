  "sentences": [
    {
      "start": 0.05,
      "end": 7.292,
      "duration": 7.242,
      "text": "Di tepi hutan kenari yang tenang, Milo si Kucing sedang duduk memandangi jalan setapak berkabut."
    },
    {
      "start": 7.292,
      "end": 10.54,
      "duration": 3.247,
      "text": "Tiba-tiba, 'Kletuk!'"
    },
    {
      "start": 10.54,
      "end": 16.545,
      "duration": 6.005,
      "text": "Ada sesuatu yang membuat hatinya berdebar cemas saat Kakek Kura-Kura datang mendekat."
    },
    {
      "start": 16.545,
      "end": 24.844,
      "duration": 8.299,
      "text": "Meski sempat merasa takut, Milo si Kucing memilih untuk bersikap jujur dan berbicara dengan penuh kelembutan."
    },
    {
      "start": 24.844,
      "end": 35.926,
      "duration": 11.082,
      "text": "Mendengar kata-katanya yang tulus, Kakek Kura-Kura tersenyum teduh dan memeluknya hangat: 'Kebaikan hatimu jauh lebih berharga daripada apa pun.'"
    },
    {
      "start": 35.926,
      "end": 41.248,
      "duration": 5.322,
      "text": "Memaafkan kecerobohan sahabat membuka pintu damai di telaga."
    },
    {
      "start": 41.248,
      "end": 49.831,
      "duration": 8.582,
      "text": "Sekarang, tarik selimut hangatmu, pejamkan matamu ya... selamat tidur, dan mimpi indah."
    }
  ],
